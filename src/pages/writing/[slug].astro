---
import Base from "../../layouts/Base.astro";
import essays from "../../content/essays.json";

/* The raw drafts carry a course header and the wrong byline. Neither belongs on
   a published surface, so the text is set here from the manuscript with the
   header dropped and the byline corrected, and the published version is linked
   as provenance where one exists. */
const meta = {
  "reader-and-writer": {
    title: "My Lifelong Career as a Reader and Writer",
    standfirst: "The books came wrapped every birthday, and they were my brother's. In a house that invested in the son, reading was the one thing nobody had assigned me.",
    where: "Published in Translingual, Issue 6, page 26",
    href: "https://ielp.ehe.osu.edu/files/2026/03/Translingual-Issue-6.pdf",
    year: "2023",
  },
  "shades-of-black": {
    title: "Shades of Black",
    standfirst: "The day I lost my grandpa I was already dressed for it, and I could not cry.",
    where: "Published in Translingual, Issue 2",
    year: "2023",
  },
  "grave-of-the-fireflies": {
    title: "A Film Analysis: Grave of the Fireflies",
    standfirst: "Two children and a war with no interest in them. Nothing in it ever jumps at you, and it takes years to put down.",
    where: "Published in Translingual, Issue 2",
    year: "2022",
  },
  "imprisonment": {
    title: "Imprisonment in The Allegory of the Cave and The House of Asterion",
    standfirst: "Imprisonment as the loss of feeling alive, which can happen with the door standing open.",
    where: "Unpublished",
    year: "2023",
  },
};

export function getStaticPaths() {
  return Object.keys(essays).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const m = meta[slug as keyof typeof meta];
const entry = (essays as Record<string, { prose: string[]; refs: string[] }>)[slug];
const prose = entry.prose;
const refs = entry.refs;
---

<Base title={m.title} description={`${m.standfirst} An essay by Linh (Min) Le.`}>
  <article class="essay-page">

    <header class="band g-ivory ep-head">
      <div class="shell">
        <a class="back" href="/beyond/">Back to Rough to Cut</a>
        <p class="eyebrow">{m.where} &middot; {m.year}</p>
        <h1>{m.title}</h1>
        <p class="standfirst">{m.standfirst}</p>
        <p class="byline">Linh (Min) Le</p>
      </div>
    </header>

    <section class="band plated g-beige" style="--plate: var(--g-ivory);">
      <div class="shell">
        <div class="ep-body">
          {prose.map((p, i) => (
            <p class={i === 0 && !/^[“"]/.test(p) ? "first" : (i === 0 ? "epigraph" : undefined)}>{p}</p>
          ))}
        </div>

        {refs.length > 0 && (
          <div class="ep-refs">
            <p class="eyebrow">References</p>
            {refs.filter((r) => !/^(References|Works Cited)\b/i.test(r)).map((r) => <p>{r}</p>)}
          </div>
        )}

        <p class="ep-out">
          {m.href
            ? <a class="cta ghost" href={m.href} target="_blank" rel="noopener">Read it as published</a>
            : null}
          <a class="cta ghost" href="/beyond/">The rest of Rough to Cut</a>
        </p>
      </div>
    </section>

  </article>
</Base>

<style>
  .ep-head { padding-block: clamp(2rem, 4vw, 3.25rem) clamp(1.6rem, 3vw, 2.5rem); }
  .back {
    font-family: var(--font-mono); font-size: var(--step--2);
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-faint); text-decoration: none;
  }
  .back:hover { color: var(--accent-deep); }
  .ep-head .eyebrow { margin-top: 1rem; }
  .ep-head h1 {
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -.018em;
    margin-top: .35rem;
    max-width: 20ch;
  }
  .standfirst {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.5;
    max-width: 48ch;
    margin-top: .9rem;
  }
  .byline {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-top: 1rem;
  }

  .ep-body { max-width: 62ch; }
  .ep-body p {
    font-size: var(--step-0);
    line-height: 1.72;
    margin-bottom: 1.15em;
  }
  .ep-body p.first::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: 3.3em;
    line-height: .8;
    padding: .05em .1em 0 0;
    color: var(--accent-deep);
    font-weight: 600;
    font-variation-settings: "SOFT" 40, "WONK" 1;
  }

  .ep-body p.epigraph {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 50, "WONK" 1;
    font-style: italic;
    font-size: var(--step-1);
    color: var(--accent-deep);
    line-height: 1.4;
    padding-left: 1rem;
    border-left: 2px solid var(--accent-line);
    margin-bottom: 1.6em;
  }

  .ep-refs {
    max-width: 62ch;
    margin-top: 2.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule-strong);
  }
  .ep-refs p { font-size: var(--step--1); color: var(--ink-faint); line-height: 1.5; margin-top: .5rem; }

  .ep-out { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2.4rem; }
  .cta {
    font-family: var(--font-mono); font-size: var(--step--2);
    letter-spacing: .08em; text-transform: uppercase; text-decoration: none;
    border-radius: 7px; padding: .6rem .95rem; display: inline-block;
    background: var(--accent-deep); color: var(--g-ivory);
    border: 1px solid var(--accent-deep);
    transition: background .25s ease, border-color .25s ease, color .25s ease;
  }
  .cta.ghost { background: transparent; color: var(--ink); border-color: color-mix(in srgb, var(--ink) 34%, transparent); }
  .cta.ghost:hover { background: var(--accent-wash); border-color: var(--accent); color: var(--accent-deep); }
  .cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
