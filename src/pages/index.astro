---
import Base from "../layouts/Base.astro";
import HeaderMark from "../components/HeaderMark.astro";
import WorkCard from "../components/WorkCard.astro";
import JobArt from "../components/JobArt.astro";
import ActionIcon from "../components/ActionIcon.astro";

const typedLines = [
  "Traced a $4.24M monthly margin deficit to product scoring",
  "Found 126,000 anomalous rows inside 862,000 transit records",
  "Showed break-even needed a 164.5% conversion rate",
  "Recovered $40,000 a year from ghost positions in a hospital budget",
];

const domains = [
  { label: "Healthcare finance", tint: "finance" },
  { label: "Payments", tint: "method" },
  { label: "E-commerce", tint: "code" },
  { label: "Retail", tint: "viz" },
  { label: "Product research", tint: "research" },
];

const toolkit = [
  { tint: "code", label: "Languages",
    body: "Python (pandas, NumPy, scikit-learn, SciPy), SQL across MySQL, PostgreSQL and DuckDB, R, and advanced Excel with macros and VBA.",
    tags: ["Python", "SQL", "DuckDB", "R", "Excel"] },
  { tint: "method", label: "Analysis",
    body: "OLS and fixed-effects regression, experiment design and pre-registration, power analysis, Bonferroni correction, difference-in-differences, k-means clustering, forecasting with holdout validation.",
    tags: ["Regression", "A/B testing", "Causal inference", "Clustering"] },
  { tint: "ai", label: "AI workflow",
    body: "Framing the question and choosing the method before delegating, defining what counts as a result in advance, and verifying output against the data.",
    tags: ["Claude Code", "ChatGPT", "Antigravity"] },
  { tint: "viz", label: "Visualization",
    body: "Power BI with DAX, Tableau, Google Looker with LookML, Plotly, and hand-built HTML and JavaScript dashboards.",
    tags: ["Power BI", "Tableau", "Looker", "Plotly"] },
  { tint: "finance", label: "Finance",
    body: "Financial modeling, scenario and break-even analysis, DuPont decomposition, budget variance reporting, and reconciliation across systems that disagree.",
    tags: ["Modeling", "DuPont", "Variance", "Reconciliation"] },
  { tint: "research", label: "Domains",
    body: "Healthcare finance operations, payments, e-commerce, retail analytics, and product research.",
    tags: ["Healthcare", "Payments", "Retail"] },
];

const experience = [
  {
    role: "Graduate Assistant",
    art: "labs",
    artLabel: "A lab spreadsheet with a formula typing into the formula bar, beside a rubric column ticking off.",
    org: "Carl H. Lindner College of Business, University of Cincinnati",
    period: "August 2026 to present",
    place: "Cincinnati, OH",
    tint: "ai",
    lines: [
      "Teach weekly technology labs for undergraduate business students covering Excel, Access, Python, and remote computing tools.",
      "Evaluate lab assignments and assessments against established rubrics, and hold weekly office hours for individual support.",
    ],
  },
  {
    role: "Product and Financial Analyst",
    art: "scissor",
    artLabel: "Conversion climbing while margin per order falls, with the $121.41 gap between them shaded.",
    org: "IterLight Lab",
    period: "March to June 2026",
    place: "Remote, internship",
    tint: "code",
    href: "/work/iterlight/",
    repo: { label: "Repository", href: "https://github.com/minminchudu/ecommerce-recommendation-margin-analysis" },
    lines: [
      "Held full ownership of an e-commerce recommendation and logistics system modelled on Wayfair, working alongside AI agents against a real deliverable every week.",
      "Analyzed unit economics across 500,000 transaction records in Python and DuckDB, tracing a $4.24M monthly gross margin deficit to misaligned product scoring and pricing rules.",
      "Directed AI coding agents to rebuild the shipping cost model on 93 pre-shipment features after the inherited version matched actuals at r = 0.9999, impossible before delivery.",
      "Built the executive Power BI dashboards and the controlled pilot framework that protected $977,000 in monthly recurring revenue.",
    ],
  },
  {
    role: "Data and Applied Analytics Trainee",
    art: "tail",
    artLabel: "A right-skewed distribution of trip durations, the mean dragged into the tail and the median holding in the bulk.",
    org: "The Global Career Accelerator",
    period: "June to August 2025",
    place: "Remote",
    tint: "method",
    repo: { label: "Repository", href: "https://github.com/minminchudu/sql-python-analytics-portfolio" },
    lines: [
      "Queried 600,000+ enterprise hardware asset records for Intel in SQL, segmenting device lifecycle cohorts across global regions.",
      "Evaluated 862,000+ transit ride records, identified data quality anomalies across 126,000 rows, and moved the trip duration benchmark to the median.",
    ],
    certs: [
      { label: "Querying Data", img: "/media/badges/querying-data.png", href: "https://www.credential.net/c58faf09-1cb7-4272-8199-6444789a9997" },
      { label: "Python and Data", img: "/media/badges/python-and-data.png", href: "https://www.credential.net/e73d0c7a-53f9-48f9-a8c0-2112d5df6a02" },
      { label: "AI Professional Skills", img: "/media/badges/ai-professional.png", href: "https://www.credential.net/120cfe47-0375-46e9-bb79-69696d6d2d84" },
      { label: "Intercultural Skills", img: "/media/badges/intercultural.png", href: "https://www.credential.net/5da605c5-3744-4899-b420-cbf2ffc39d1c" },
    ],
  },
  {
    role: "Finance Assistant, Department of Radiology",
    art: "roster",
    artLabel: "A grid of budgeted positions where three ghost allocations are struck out and removed.",
    org: "The Ohio State University Wexner Medical Center",
    period: "June 2024 to May 2025",
    place: "Columbus, OH",
    tint: "finance",
    href: "/work/radiology/",
    lines: [
      "Audited HRIS position allocations for 100+ clinical and administrative radiology staff, eliminating ghost positions and securing $40,000+ in annual savings.",
      "Built an automated Excel reconciliation tool across three financial ledgers that recovered $9,000+ in outstanding reimbursements.",
      "Monitored 50+ vendor contracts covering $300,000+ in annual spend, detecting unit price drift and delivering monthly variance reports to leadership.",
    ],
  },
];
---

<Base
  title="Linh (Min) Le"
  description="Data, business and BI analysis across healthcare finance, payments, e-commerce and retail. Python, SQL, Power BI, Tableau."
>
  <section class="hero g-ivory">
    <div class="shell">
      <div class="hero-mark" data-float="14"><HeaderMark /></div>
      <div class="hero-text">
        <p class="eyebrow">Data Analyst, Business Analyst, BI Analyst</p>
        <h1>Linh (Min) Le</h1>
        <p class="typer" data-typer={JSON.stringify(typedLines)}>
          <span class="typed">{typedLines[0]}</span><span class="tcaret" aria-hidden="true"></span>
        </p>
        <p class="lead">
          Analysis across healthcare finance, payments, e-commerce and retail, with an
          accounting foundation underneath it and information systems training on top.
        </p>
        <div class="chips">
          {domains.map((d) => <span class={`chip tint-${d.tint}`}>{d.label}</span>)}
        </div>
        <div class="hero-cta">
          <a class="cta with-icon" href="https://github.com/minminchudu" target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01
                1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95
                0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09
                2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87
                3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0
                16 8c0-4.42-3.58-8-8-8Z"/>
            </svg>
            <span>GitHub</span>
          </a>
          <a class="cta ghost" href="/media/Linh_Le_Resume.pdf" target="_blank" rel="noopener">Resume</a>
          <a class="cta ghost with-icon" href="https://www.linkedin.com/in/linh-tt-le/" target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M3.6 5.4H.9V15h2.7V5.4ZM2.25 1A1.55 1.55 0 1 0 2.25 4.1
                1.55 1.55 0 0 0 2.25 1ZM15.1 9.53c0-2.6-1.39-3.81-3.24-3.81-1.5 0-2.17.82-2.54
                1.4V5.4H6.62c.04.76 0 9.6 0 9.6h2.7V9.64c0-.24.02-.48.09-.65.19-.48.63-.98
                1.37-.98.96 0 1.35.73 1.35 1.81V15h2.97V9.53Z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="band plated g-leaf narrative" style="--plate: var(--g-beige);" data-rail-section>
    <div class="shell narrative-inner">
      <aside class="narrative-rail" aria-hidden="true">
        <span class="rail-track"><span class="rail-fill" data-rail></span></span>
        <span class="rail-facet"></span>
      </aside>

      <div class="opening prose">
        <p class="eyebrow">The first thing I found</p>
        <p class="first reveal">
          For a year, I worked with the funding records of a hospital radiology department,
          the one behind every MRI, CT, and ultrasound in an academic medical center.
        </p>
        <p class="reveal">
          Buried in those records were fifteen positions still funded at levels that three
          reorganizations had already changed. Roughly $40,000 a year kept moving through
          the budget as if nothing had happened.
        </p>
        <p class="reveal">
          Payroll ran correctly. The ledger balanced. Month after month, the numbers behaved
          exactly as they were supposed to.
        </p>
        <p class="beat reveal">That was what made the error easy to miss.</p>
        <p class="reveal">
          A hospital budget reaches far beyond the ledger. The money in those records supports
          the people running the department, the contracts that keep imaging equipment working,
          and the supplies used in patient care. An outdated allocation can sit quietly for
          months while money remains tied to a version of the department that has already changed.
        </p>
        <p class="reveal">
          That experience left me with a habit I have carried into every project since: when a
          number looks settled, I still want to know what is underneath it.
        </p>
        <p class="reveal">I think that is where a lot of good analytical work begins.</p>
      </div>

      <aside class="narrative-aside reveal">
        <span class="aside-figure band-value">$40,000</span>
        <span class="aside-label">a year, still moving through a budget that had already changed</span>
        <span class="aside-rule"></span>
        <span class="aside-figure band-value">15</span>
        <span class="aside-label">positions funded at levels three reorganizations had replaced</span>
      </aside>
    </div>
  </section>

  <section class="band plated g-cream has-cards" id="work" style="--plate: var(--g-leaf);">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2 class="words" data-words>What turned up underneath</h2>
        <p class="section-note">
          The finding comes first in each of these, and the method follows it. All of the work
          analyses public companies from public data, done independently and with no affiliation
          to any of them, and where a figure is a projection rather than a measurement it says so.
        </p>
      </header>

      <div class="cards">
        <WorkCard
          featured
          project="Compass AI, Spotify"
          period="August 2026"
          tint="finance"
          image="/figures/compass-conversion-decline.png"
          imageAlt="Time series of Spotify's quarterly free-to-paid conversion rate declining across the analysis window."
          finding="The best next action is sometimes to say nothing at all"
          context="Viet Career Conference Think-A-Thon, Seattle. Second place. Diagnostic and quantitative analyst lead."
          body="Most conversion tooling asks which offer to show. Compass AI scores staying silent as a candidate action that every other option has to beat, which turns promotion fatigue from a side effect into a modelled cost. Built a 32-quarter financial database from Spotify SEC filings, separated subscriber churn from conversion flow, and sized the case on a persuadability segmentation rather than on the raw size of the free base."
          metrics={[
            { value: "63%", label: "Conversion decline" },
            { value: "€4.7M", label: "Year-1 net benefit" },
            { value: "46.9%", label: "Year-1 ROI" },
            { value: "6.7 mo", label: "Payback" },
          ]}
          note="Designed and modelled, never deployed. Figures are projections under stated assumptions, gated on a randomised pilot clearing 1.33pp of measured lift. The second-place finish is the measured outcome."
          links={[
            { label: "Read the case study", href: "/work/compass-ai/" },
            { label: "Deck (PDF)", href: "/media/Linh_Le_Compass_AI_Spotify_Conversion.pdf" },
            { label: "Certificate (PDF)", href: "/media/Linh_Le_ThinkAThon_Runner_Up_Certificate.pdf" },
          ]}
        />

        <WorkCard
          project="IterLight Lab"
          period="March to June 2026"
          tint="code"
          image="/figures/iterlight-cvr-margin-anomaly.png"
          imageAlt="Bubble chart of margin per impression against conversion rate across twelve furniture categories, trending downward at r equals minus 0.71."
          finding="Break-even required a 164.5% conversion rate"
          context="E-commerce recommendation engine. Product and financial analyst."
          body="Conversion was climbing while gross margin fell. Shipping cost averaged $309.77 against an order value of $188.36, so every completed sale opened a $121.41 hole and higher conversion made the position worse."
          metrics={[
            { value: "164.5%", label: "Break-even CVR" },
            { value: "51x", label: "Above actual" },
            { value: "$4.24M", label: "Monthly loss" },
          ]}
          links={[
            { label: "Read the case study", href: "/work/iterlight/" },
            { label: "Repository", href: "https://github.com/minminchudu/ecommerce-recommendation-margin-analysis" },
            { label: "Dashboard (PDF)", href: "/media/Linh_Le_IterLight_PowerBI_Dashboard.pdf" },
          ]}
        />

        <WorkCard
          project="Contactless Enablement Priority Model"
          period="May 2026"
          tint="method"
          image="/figures/contactless-gap-vs-priority.png"
          imageAlt="Scatter plot of enablement priority score against gap to the global benchmark across seven merchant sectors, with a nearly flat trend line."
          finding="The biggest adoption gaps were the worst places to invest"
          context="Merchant enablement priority analysis on Federal Reserve payments data. Sole analyst."
          body="Healthcare sits 55 points below the global contactless benchmark, the largest gap in the US market, and ranks seventh of nine for investment priority. Visit frequency explains 94% of the variation between sectors."
          metrics={[
            { value: "94%", label: "Variation explained" },
            { value: "3.91B", label: "Incremental txns" },
            { value: "94.9%", label: "Weightings held" },
          ]}
          links={[
            { label: "Read the case study", href: "/work/contactless/" },
            { label: "Repository", href: "https://github.com/minminchudu/contactless-enablement-priority-model" },
            { label: "Live dashboard", href: "/media/Linh_Le_Contactless_Priority_Dashboard.html" },
          ]}
        />

        <WorkCard
          project="Instagram Feed Fatigue Audit"
          period="April 2026"
          tint="research"
          image="/figures/instagram-failure-modes.png"
          imageAlt="Horizontal bar chart ranking six Instagram failure modes by complaint intensity, from social graph collapse at 95 down to commerce sameness at 58."
          finding="Loops drive people off the platform, ahead of ads"
          context="Product and retention research. Research and synthesis lead."
          body="Complaints about a feed stuck on one topic carry the language of app abandonment. Complaints about advertising read as resignation. Six failure modes ranked across 17 venue types, each corroborated against earnings calls, court testimony and SEC disclosure."
          metrics={[
            { value: "95/100", label: "Top intensity" },
            { value: "17", label: "Venue types" },
            { value: "3B", label: "Users at stake" },
          ]}
          links={[
            { label: "Read the case study", href: "/work/instagram/" },
            { label: "Live dashboard", href: "/media/Linh_Le_Feed_Fatigue_Dashboard.html" },
          ]}
        />

        <WorkCard
          project="Walmart Promotional Strategy"
          period="April 2026"
          tint="viz"
          image="/figures/walmart-revenue-scenarios.png"
          imageAlt="Bar chart of weekly revenue by recommendation scenario, showing the baseline and the two increments that sum to the projected lift."
          finding="Only two of five markdown types paid for themselves"
          context="Promotional and inventory strategy across Walmart store formats. Diagnostic analytics lead."
          body="MarkDown3 returns $10.12 per dollar and MarkDown5 returns $5.25. The other three return nothing distinguishable from zero, and Type C stores show no measurable response at all."
          metrics={[
            { value: "68.5%", label: "R², N = 2,295" },
            { value: "2 of 5", label: "Markdowns working" },
            { value: "$48,799", label: "Weekly, per store" },
          ]}
          links={[
            { label: "Read the case study", href: "/work/walmart/" },
            { label: "Deck (PDF)", href: "/media/Linh_Le_Walmart_Promotional_Strategy.pdf" },
          ]}
        />

        <WorkCard
          project="Video Game Publisher Selection"
          period="March 2026"
          tint="finance"
          image="/figures/publisher-genre-sales.png"
          imageAlt="Bar chart of total video game sales by genre with the shooter genre highlighted at 557 million dollars."
          finding="The strongest financials belonged to the publisher we did not choose"
          context="Publisher partnership and financial strategy analysis. Co-analyst."
          body="Ubisoft came out ahead on every growth measure tested. The recommendation still went to Activision, because its advantage is genre-specific and platform-specific: 42.74% of its own portfolio sits in Shooter, on the console where the title would launch."
          metrics={[
            { value: "$557.35M", label: "Genre sales" },
            { value: "42.74%", label: "Portfolio in genre" },
          ]}
          links={[
            { label: "Read the case study", href: "/work/publisher/" },
            { label: "Deck (PDF)", href: "/media/Linh_Le_Publisher_Selection_Analysis.pdf" },
          ]}
        />

        <WorkCard
          project="Decision Sciences and Operations Analysis"
          period="Fall 2023"
          tint="ai"
          image="/figures/decision-control-rule-tradeoff.png"
          imageAlt="Grouped bars comparing two manufacturing control rules on their two failure modes, showing the error rates trading places between them."
          finding="The regression did not support the complaint it was built to test"
          context="Six business decisions, six methods. Co-analyst."
          body="An employee said her severance offer was too low. Three competing regressions were compared on adjusted R-squared, age was dropped for collinearity with tenure, and the selected model put her seven weeks inside the predicted range. The other five covered fare evasion sizing, a manufacturing control rule where the answer was a quantified trade-off rather than a winner, two loyalty incentive questions, a paired ergonomics test and a three-way layout comparison."
          metrics={[
            { value: "$1.1M", label: "Annual fare leakage, low end" },
            { value: "78.2%", label: "Defects the cheap rule misses" },
            { value: "0.7363", label: "Adjusted R-squared" },
          ]}
          links={[
            { label: "Read the case study", href: "/work/decision-sciences/" },
          ]}
        />
      </div>

    </div>
  </section>

  

  <section class="band plated g-beige" id="experience" style="--plate: var(--g-leaf);" data-track-section>
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">Experience</p>
        <h2 class="words" data-words>Where the work happened</h2>
      </header>

      <div class="timeline">
        <span class="tl-track" aria-hidden="true"><span class="tl-fill" data-track></span></span>
        {experience.map((job, i) => (
          <article class={`job reveal tint-${job.tint} ${i % 2 ? "flip" : ""}`}>
            <div class="job-rail" aria-hidden="true"><span class="node"></span></div>
            <div class="job-card">
              <div class="job-art" data-float="16"><JobArt kind={job.art} label={job.artLabel} /></div>
              <div class="job-body">
                <div class="job-when">
                  <span class="figure">{job.period}</span>
                  <span class="job-place">{job.place}</span>
                </div>
                <div class="job-what">
                  <h3 class="job-role">{job.role}</h3>
                  <p class="job-org">{job.org}</p>
                  <ul class="job-lines">
                    {job.lines.map((line) => <li>{line}</li>)}
                  </ul>
                  {job.certs && (
                    <div class="job-certs">
                      <p class="job-certs-label">Certified by the programme</p>
                      <ul class="badges">
                        {job.certs.map((c) => (
                          <li>
                            <a href={c.href} target="_blank" rel="noopener" title={`${c.label} certification, verify on Credential.net`}>
                              <img src={c.img} width="348" height="292" loading="lazy" decoding="async"
                                   alt={`${c.label} certification from The Global Career Accelerator`} />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {(job.href || job.repo) && (
                    <p class="job-links">
                      {job.href && (
                        <a class="job-link" href={job.href}><span>Read the case study</span></a>
                      )}
                      {job.repo && (
                        <a class="job-link" href={job.repo.href} target="_blank" rel="noopener">
                          <ActionIcon href={job.repo.href} />
                          <span>{job.repo.label}</span>
                        </a>
                      )}
                    </p>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band plated g-leaf" style="--plate: var(--g-ivory);">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">Education and volunteer</p>
        <h2 class="words" data-words>Accounting first, then systems</h2>
      </header>

      <ol class="creds">
        <li class="cred reveal tint-ai">
          <span class="cred-mark" aria-hidden="true"></span>
          <p class="cred-when figure">Expected November 2027</p>
          <h3 class="cred-title">M.S. Information Systems</h3>
          <p class="cred-org">Carl H. Lindner College of Business, University of Cincinnati</p>
          <p class="cred-note">Graduate Certificate in Data Analytics</p>
        </li>

        <li class="cred reveal tint-code">
          <span class="cred-mark" aria-hidden="true"></span>
          <p class="cred-when figure">August 2026 &middot; GPA 3.69</p>
          <h3 class="cred-title">B.S.B.A. in Accounting</h3>
          <p class="cred-org">Max M. Fisher College of Business, The Ohio State University</p>
          <p class="cred-note">Magna Cum Laude &middot; Dean&rsquo;s List &middot; Fisher College of Business Scholar</p>
        </li>

        <li class="cred reveal tint-research">
          <span class="cred-mark" aria-hidden="true"></span>
          <p class="cred-when figure">June to August 2025 &middot; Remote</p>
          <h3 class="cred-title">Finance Intern, volunteer</h3>
          <p class="cred-org">Unity Bands Inc.</p>
          <p class="cred-note">
            Financial tracking for healthcare worker support programs, budgeting for
            fundraising initiatives, and preparation of tax and compliance documents.
          </p>
        </li>
      </ol>
    </div>
  </section>

<section class="band plated g-ivory" id="toolkit" style="--plate: var(--g-leaf);">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">Toolkit</p>
        <h2 class="words" data-words>What the work is built with</h2>
      </header>
      <p class="tk-lead section-note">Pick one to bring it forward and set the rest back.</p>
      <div class="tk-grid" data-focus-group>
        {toolkit.map((row) => (
          <button type="button" class={`tk-card reveal tint-${row.tint}`} data-focusable aria-pressed="false" data-tilt>
            <span class="tk-head">
              <span class="tk-facet" aria-hidden="true"></span>
              <span class="tk-label">{row.label}</span>
            </span>
            <span class="tk-body">{row.body}</span>
            <span class="tk-tags">
              {row.tags.map((tag) => <span class="tk-tag">{tag}</span>)}
            </span>
            <span class="tk-hint" aria-hidden="true">Click to focus</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="band plated g-leaf-deep" id="contact" style="--plate: var(--g-beige);">
    <div class="shell">
      <div class="closing">
        <p class="eyebrow">Get in touch</p>
        <h2 class="words" data-words>Available for analyst roles from Summer 2027.</h2>
        <p class="closing-note">
          My work so far spans healthcare finance, payments, e-commerce, retail and product
          research. What those have in common matters more than the sector does: a number
          somebody is about to act on, and a question about whether it holds.
        </p>
