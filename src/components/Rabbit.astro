---
// Colophon mark at the foot of the page.
---

<svg class="rabbit" viewBox="0 0 44 48" role="presentation" aria-hidden="true">
  <g stroke="var(--accent)" fill="none" stroke-width="1.3" stroke-linecap="round">
    <ellipse cx="16.5" cy="12" rx="3.3" ry="8.6" transform="rotate(-13 16.5 12)"/>
    <ellipse cx="26" cy="12" rx="3.3" ry="8.6" transform="rotate(13 26 12)"/>
    <circle cx="21" cy="26" r="6.4"/>
    <ellipse cx="21.5" cy="37" rx="9.6" ry="6.6"/>
    <circle cx="33" cy="34.5" r="2.3"/>
  </g>
  <circle class="eye" cx="18.6" cy="25" r=".95" fill="var(--accent)"/>
</svg>

<style>
  .rabbit { width: 34px; height: auto; }

  @keyframes bunBlink {
    0%, 92%, 100% { transform: scaleY(1) }
    95%, 97%      { transform: scaleY(.12) }
  }
  .eye { transform-box: fill-box; transform-origin: center; animation: bunBlink 7s ease-in-out 2s infinite }

  @media (prefers-reduced-motion: reduce) { .eye { animation: none } }
</style>
