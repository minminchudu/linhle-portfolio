---
/* A glyph that says what kind of destination a link goes to, inferred from the
   href rather than set by hand so it can never disagree with the link. Three
   kinds only: a repository, a file that downloads, a page that opens live.
   Internal links get nothing, because the label already carries them. */
interface Props {
  href: string;
}
const { href } = Astro.props;

const kind =
  /github\.com/i.test(href) ? "repo"
  : /\.pdf(\?|#|$)/i.test(href) ? "pdf"
  : /\.pbix(\?|#|$)/i.test(href) ? "pdf"
  : /\.html?(\?|#|$)/i.test(href) ? "live"
  : /^https?:/i.test(href) ? "live"
  : null;
---

{kind === "repo" && (
  <svg class="ai" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
      0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01
      1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95
      0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09
      2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87
      3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0
      16 8c0-4.42-3.58-8-8-8Z"/>
  </svg>
)}

{kind === "pdf" && (
  <svg class="ai" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false"
       fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9.2 1.6H4.4a1.2 1.2 0 0 0-1.2 1.2v10.4a1.2 1.2 0 0 0 1.2 1.2h7.2a1.2 1.2 0 0 0 1.2-1.2V5.2Z"/>
    <path d="M9.2 1.6v3.6h3.6"/>
    <path d="M8 8v4"/>
    <path d="M6.2 10.2 8 12l1.8-1.8"/>
  </svg>
)}

{kind === "live" && (
  <svg class="ai" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false"
       fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 3.2H3.4a1.2 1.2 0 0 0-1.2 1.2v8.2a1.2 1.2 0 0 0 1.2 1.2h8.2a1.2 1.2 0 0 0 1.2-1.2V9"/>
    <path d="M9.6 2.4h4v4"/>
    <path d="M13.6 2.4 7.4 8.6"/>
  </svg>
)}

<style>
  .ai { flex: none; opacity: .82; }
</style>
